# ============================================================
# Code Documentation Assistant — Environment Configuration
# ============================================================
# Copy this file to .env and adjust values as needed.
# docker compose reads .env automatically.
# ============================================================

# --- Model tier ---
# Capability selector. Controls which base model is deployed.
#   full        → mistral-nemo:12b-instruct          (best quality, GPU + 12Gi+)
#   balanced    → deepseek-coder-v2:16b-lite-instruct (best code understanding, mid-range)
#   lightweight → phi3.5                              (edge/low-resource, ~4Gi)
#   minimal     → qwen2.5-coder:3b-instruct           (CI pipelines / very constrained dev)
MODEL_TIER=full

# --- Quantisation ---
# Resource selector. Composed with MODEL_TIER to produce the final Ollama model tag.
#   q4_K_M → ~50% memory reduction, minimal quality loss  (recommended)
#   q8_0   → ~25% memory reduction, near lossless
#   fp16   → full precision, full memory footprint
# Note: lightweight and minimal tiers use Ollama's built-in default quantisation;
# this value is ignored for those tiers.
QUANTISATION=q4_K_M

# --- Deployment target ---
# Infrastructure selector.
#   local   → developer laptop / single-node; no resource limits; lighter healthchecks;
#             ChromaDB searchEf reduced for speed; host-path volumes
#   cluster → production k8s; resource limits enforced; PVCs; full HNSW searchEf
DEPLOYMENT_TARGET=local

# --- Embedding model ---
# WARNING: changing this after ingestion requires full re-ingestion.
#   nomic-embed-text  → 768-dim  (default)
#   all-minilm        → 384-dim  (lightweight)
#   mxbai-embed-large → 1024-dim (rich)
EMBEDDING_MODEL=nomic-embed-text

# --- Log level ---
LOG_LEVEL=info

# --- Repo path ---
# Path to the codebase to ingest (mounted read-only into the app container)
REPO_PATH=./repos

# ============================================================
# dev branch — inference backend
# ============================================================

# ollama | vllm
INFERENCE_BACKEND=ollama

# vLLM — only needed when INFERENCE_BACKEND=vllm
# HF_TOKEN is required to pull gated models from HuggingFace Hub
HF_TOKEN=
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
VLLM_TP=1

# ============================================================
# dev branch — agent behaviour
# ============================================================

HITL_ENABLED=true

# Post-generation quality gate:
#   human      → HITL-2: pause and wait for human rating + decision
#   supervisor → Supervisor LLM evaluates output; silent retry if fail
#   self       → Generation LLM self-critiques before emitting
#   off        → No post-generation check; accept immediately
OUTPUT_REVIEW_MODE=human

QUALITY_GATE_THRESHOLD=6.0
CONFIDENCE_THRESHOLD=0.45
MAX_RETRIEVAL_ATTEMPTS=3
MAX_GENERATION_ATTEMPTS=3
MAX_CONTEXT_TOKENS=8000

# ============================================================
# dev branch — graph DB (Kuzu)
# ============================================================

# Set to false to skip graph build entirely (e.g. if kuzu not installed)
GRAPH_ENABLED=true

# Directory where Kuzu persists the graph (inside the container)
GRAPH_PATH=/data/graph

# Number of recent git commits to analyse for co-change graph
GRAPH_CO_CHANGE_COMMITS=100

# ============================================================
# dev branch — MCP servers
# ============================================================
# Each MCP server is opt-in. Set ENABLED=true and provide the URL
# for any server you want to activate. MCP tools are only offered
# to full/balanced tier models (is_mcp_capable() check in tools.py).

# Filesystem MCP — declarative file access with permission tiers
MCP_FILESYSTEM_ENABLED=false
MCP_FILESYSTEM_URL=http://localhost:3000

# GitHub MCP — OAuth-handled GitHub operations (read-only on dev)
MCP_GITHUB_ENABLED=false
MCP_GITHUB_URL=http://localhost:3001

# Slack MCP — developer workflow + self-documentation side-effects
MCP_SLACK_ENABLED=false
MCP_SLACK_URL=http://localhost:3002

# ============================================================
# dev branch — MLflow
# ============================================================

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=code-doc-assistant
